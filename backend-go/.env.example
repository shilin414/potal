# Creation Agent Studio — Go backend configuration
# Copy to .env.local (git-ignored) and fill in real secrets.
# Real secrets must NEVER be committed.

APP_ENV=development            # development | production | test
LOG_LEVEL=info

# Process addresses
API_ADDR=:8080                 # studio-api  (short requests)
STREAM_ADDR=:8081              # studio-stream (SSE long connections)
METRICS_ADDR=:9090
PPROF_ENABLED=false

# ── Database: TiDB 8.0.0 via TiProxy. Schema is MySQL 5.7 compatible. ──
# The Go backend uses its OWN clean database, xiaoan3_go (the retired Django
# stack used xiaoan3; do not touch that database). One-time bootstrap
# (xiaoanuser lacks CREATE DATABASE):
#   as admin: CREATE DATABASE xiaoan3_go CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
#   GRANT ALL PRIVILEGES ON xiaoan3_go.* TO 'xiaoanuser'@'%';
DB_HOST=192.168.212.38
DB_PORT=6000
DB_NAME=xiaoan3_go
DB_USER=xiaoanuser
DB_PASSWORD=replace-me
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=10
DB_QUERY_TIMEOUT=15s

# ── Redis: one logical DB, every key prefixed xiaoan3: ──
REDIS_HOST=192.168.211.239
REDIS_PORT=6380
REDIS_DB=2
REDIS_PASSWORD=replace-me
REDIS_KEY_PREFIX=xiaoan3

# ── Feishu / Aily (secrets from environment only) ──
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_REDIRECT_URI=http://localhost:3030/auth/feishu/callback
FEISHU_BASE_URL=https://open.feishu.cn
AILY_BASE_URL=https://open.feishu.cn/open-apis
AILY_START_RATE_LIMIT=10       # official chats limit: 10/s
AILY_MAX_INFLIGHT=100
AILY_POLL_BACKOFF_SECONDS=1,2,3,5
AILY_STREAM_TIMEOUT=330s
AILY_REQUEST_TIMEOUT=30s

# ── Execution plane ──
RUN_LEASE_SECONDS=120s
RUN_LEASE_HEARTBEAT_SECONDS=30s
RUN_CLAIM_BATCH_SIZE=10
RUN_REAPER_INTERVAL=20s
OUTBOX_RELAY_INTERVAL=500ms
WORKER_CONCURRENCY=10
# WORKER_ID= (defaults to hostname-pid)

# ── Session / auth ──
SESSION_TTL=12h
SESSION_COOKIE_NAME=studio_session
CSRF_COOKIE_NAME=studio_csrf
# AES-256-GCM key material for Feishu refresh tokens at rest
TOKEN_ENCRYPTION_KEY=replace-me
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── Storage (attachments / avatars / mirrored artifacts) ──
STORAGE_DRIVER=localfs         # localfs | s3
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=   # empty = local spans only
OTEL_SERVICE_NAME=studio-backend
OTEL_SAMPLING_RATE=0.1
